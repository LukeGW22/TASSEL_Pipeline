# config.env — Project path configuration for TXBM21-26
# Copy to config.env and fill in values before running any scripts.
# All scripts source this file; nothing is hardcoded.
# config.env is gitignored — config.env.template is version-controlled.
#
# On Grace HPRC:
#   DATA_ROOT    → $SCRATCH/...  (90-day purge policy, fast parallel I/O)
#   PROJECT_ROOT → $WORK/TXBM21-26  (longer retention, version-controlled)
#
# Directory structure this config describes:
#
#   $DATA_ROOT/                                    ← SCRATCH
#   ├── Raw_genomic_data/Breeding_Lines/FASTQ/     ← original FASTQ (read-only)
#   ├── PolyA_FASTQ/                               ← output of 1_Preprocessing
#   └── Reference_Genomes/                         ← reference genome + BWA index
#
#   $PROJECT_ROOT/                                 ← WORK
#   ├── Config/                                    ← params.yaml, config.env
#   ├── Scripts/                                   ← all pipeline scripts
#   │   ├── 1_Preprocessing/
#   │   ├── 2_SNPCalling/
#   │   ├── 3_Filtering/
#   │   └── 4_Imputation/
#   ├── Logs/YYYY-MM-DD/                           ← all SLURM job logs (gitignored)
#   ├── GBS_Metadata/                              ← key files, lines files (version-controlled)
#   └── TASSEL_Workflow_Outputs/                   ← all pipeline outputs (gitignored)
#       ├── hapmap/
#       ├── logs/
#       ├── database/
#       ├── alignment/
#       ├── HDF5/
#       ├── stats/
#       └── summaries/

# ── Root directories ───────────────────────────────────────────────────────────
DATA_ROOT="/scratch/group/genomic_predict/SNP_Calling"
PROJECT_ROOT="/scratch/group/genomic_predict/SNP_Calling/TXBM21-26"

# ── Input directories (under DATA_ROOT) ───────────────────────────────────────
RAW_FASTQ_DIR="${DATA_ROOT}/Raw_genomic_data/Breeding_Lines/FASTQ"
FASTQ_DIR="${DATA_ROOT}/PolyA_FASTQ"         # Poly-A processed FASTQ — input to 2_SNPCalling
REF_GENOME_DIR="${DATA_ROOT}/Reference_Genomes"

# ── Reference genome (file path used directly by BWA and TASSEL) ──────────────
RG="${REF_GENOME_DIR}/iwgsc_refseqv2.1_assembly.fa"
# BWA index files (*.bwt, *.pac, *.ann, *.amb, *.sa) must exist alongside $RG

# ── Metadata (under PROJECT_ROOT, version-controlled) ─────────────────────────
METADATA_DIR="${DATA_ROOT}/GBS_Metadata"
# To decouple scripts from timestamped filenames, create symlinks once manually:
#   ln -sf TXBM21-26_KEY-20260724_210705.txt   ${METADATA_DIR}/current_key.txt
#   ln -sf TXBM21-26_LINES-20260724_210705.txt ${METADATA_DIR}/current_lines.txt
# Then set DKF/PKF/TF to the symlink paths below, or point directly to the files.
DKF="${METADATA_DIR}/TXBM21-26_KEY-20260724_210705.txt"     # Discovery key file  (→ TASSEL -k)
PKF="${METADATA_DIR}/TXBM21-26_KEY-20260724_210705.txt"     # Production key file (→ TASSEL -k)
TF="${METADATA_DIR}/TXBM21-26_LINES-20260724_210705.txt"    # Taxa/LINES file     (→ TASSEL -taxa)

# ── Log directory (all SLURM stdout/stderr, organized by date) ────────────────
LOG_DIR="${PROJECT_ROOT}/Logs"            # Scripts append $(date +%Y-%m-%d) at runtime

# ── Output directories ───────────
# all TASSEL pipeline outputs consolidated here
OUTPUT_DIR="${PROJECT_ROOT}/TASSEL_Workflow_Outputs"

# pre-imputation filtering outputs (vcfs)
PI_FILTER_DIR="${PROJECT_ROOT}/Pre-Imputation_Filtering"

# imputation outputs (vcfs)
IMPUTE_DIR="${PROJECT_ROOT}/Imputation"

# post-imputation filtering outputs (vcfs, hapmaps)
POST_IMPUTE_FILTER_DIR="${PROJECT_ROOT}/Post-Imputation_Filtering"

# ── Study identifier (used in output file names) ───────────────────────────────
STUDY="TXBM21-26"

# ── Enzyme ─────────────────────────────────────────────────────────────────────
# DO NOT CHANGE unless the library prep enzyme combination changed.
ENZYME="PstI-MspI"

# ── SNP calling thresholds ─────────────────────────────────────────────────────
MIN_READ_COUNT=1            # Minimum tag count across all taxa   (TagExportToFastqPlugin -c)
MIN_QUALITY_SCORE=0         # Minimum FASTQ base quality score    (GBSSeqToTagDBPlugin -mnQS); keep 0 for poly-A reads
MIN_LOCUS_COVERAGE=0.20     # Minimum proportion of taxa with data (ProductionSNPCallerPluginV2 -mnLCov); 0.20 = 80% missing allowed
MIN_MINOR_ALLELE_FREQ=0.001 # Minimum minor allele frequency      (ProductionSNPCallerPluginV2 -mnMAF)

# ── Java heap memory ───────────────────────────────────────────────────────────
JAVA_MIN_MEM="10g"
JAVA_MAX_MEM="150g"

# ── BWA alignment threads ──────────────────────────────────────────────────────
BWA_THREADS=48

# ── SLURM job settings (for Call_SNPs_launch.sh) ──────────────────────────────
SLURM_ACCOUNT="132740983644"
SLURM_MAIL_USER="luke.whiteley@ag.tamu.edu"
SLURM_TIME="2-00:00:00"
SLURM_CPUS=48
SLURM_MEM="300GB"
